{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },

    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
      "oauth": {}
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "openai-docs": {
      "type": "remote",
      "url": "https://developers.openai.com/mcp",
      "enabled": true
    },

    "outline": {
      "type": "remote",
      "url": "https://outline.z.madsoftware.tech/mcp",
      "enabled": true
    },
    "kravos-platform": {
      "type": "remote",
      "url": "https://mcp.kravos.ai/api/v1",
      "enabled": true
    },
    "plane": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--with",
        "plane-mcp-server==0.2.10",
        "scripts/plane-mcp-compat.py"
      ],
      "enabled": true,
      "environment": {
        "PLANE_API_KEY": "{env:PLANE_API_KEY}",
        "PLANE_WORKSPACE_SLUG": "{env:PLANE_WORKSPACE_SLUG}",
        "PLANE_BASE_URL": "{env:PLANE_BASE_URL}"
      }
    }
  },
  "tools": {
    "github_*": false
  }
}
